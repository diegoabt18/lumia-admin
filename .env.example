# =============================================================================
# Lumia Admin — variables de entorno (copiar a .env; nunca versionar .env)
# Todas son de SERVIDOR (BFF) salvo las NUXT_PUBLIC_*. Ninguna contiene secretos.
# =============================================================================

# --- Conexión con el Server (privada: nunca llega al navegador) ---------------
# Docker (compose de este proyecto, unido a la red del Server):
#   perfil atlas/prod del Server → http://server-api:3001   (container_name: server-api)
#   perfil local del Server      → http://api:3001          (nombre del servicio)
# Fuera de Docker (npm run dev / preview en el host) → http://127.0.0.1:3001
NUXT_API_BASE_URL=http://server-api:3001

# Timeout de cada llamada al Server (ms)
NUXT_API_TIMEOUT_MS=15000

# Nombres de cookie del Server (COOKIE_ACCESS_NAME / COOKIE_REFRESH_NAME en server/.env*)
NUXT_SERVER_ACCESS_COOKIE_NAME=lumia_access
NUXT_SERVER_REFRESH_COOKIE_NAME=lumia_refresh

# --- Sesión propia de Lumia Admin ---------------------------------------------
# Secure en las cookies del admin. true funciona en http://localhost (Chrome, Firefox, Edge).
# Pon false SOLO si accedes por http con una IP/host distinto de localhost.
NUXT_SESSION_COOKIE_SECURE=true

# Orígenes adicionales permitidos para POST/PUT/PATCH/DELETE (separados por coma).
# Vacío = solo el mismo origen que sirve la app (recomendado).
NUXT_ALLOWED_ORIGINS=

# --- Docker -------------------------------------------------------------------
# Puerto del host (solo 127.0.0.1)
LUMIA_ADMIN_PORT=3100
# Red Docker del Server (proyecto compose `server` + red `lumia-network`)
SERVER_DOCKER_NETWORK=server_lumia-network

# --- Presentación (públicas) --------------------------------------------------
NUXT_PUBLIC_STORE_CURRENCY=COP
NUXT_PUBLIC_STORE_LOCALE=es-CO
NUXT_PUBLIC_STORE_TIMEZONE=America/Bogota
