{
  "name": "lumia-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lumia Admin - aplicación administrativa interna. Nuxt 4 + BFF Nitro hacia el Server Fastify.",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev --port 3100",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "permissions:check": "node scripts/check-permissions.mjs",
    "verify": "npm run contracts:check && npm run permissions:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@tabler/icons-vue": "3.46.0",
    "@vee-validate/zod": "4.15.1",
    "nuxt": "4.5.1",
    "vee-validate": "4.15.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "vue-sonner": "2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.8"
  }
}
